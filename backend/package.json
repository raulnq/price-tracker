{
  "name": "@price-tracker/backend",
  "description": "Price Tracker API",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch src/index.ts",
    "dev:scheduler": "cross-env NODE_ENV=development tsx watch src/scheduler.ts",
    "build": "tsc && tsc-alias",
    "start": "cross-env NODE_ENV=production node dist/index.js",
    "start:scheduler": "cross-env NODE_ENV=production node dist/scheduler.js",
    "database:generate": "tsx ./node_modules/drizzle-kit/bin.cjs generate",
    "database:migrate": "tsx ./node_modules/drizzle-kit/bin.cjs migrate",
    "database:studio": "tsx ./node_modules/drizzle-kit/bin.cjs studio",
    "test": "cross-env NODE_ENV=test tsx --import ./tests/setup.ts --test ./tests/**/*.test.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@hono/node-server": "^1.19.5",
    "@hono/zod-validator": "^0.7.5",
    "dotenv": "^17.2.3",
    "dotenv-expand": "^12.0.3",
    "drizzle-kit": "^0.31.8",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.10.3",
    "hono-pino": "^0.10.3",
    "http-problem-details": "^0.1.7",
    "http-status-codes": "^2.3.0",
    "mailtrap": "^4.4.0",
    "node-cron": "^4.2.1",
    "pg": "^8.16.3",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.3",
    "pino-seq": "^3.0.0",
    "playwright": "^1.57.0",
    "tsx": "^4.7.1",
    "uuid": "^13.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.1.0",
    "@types/node": "^20.11.17",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.16.0",
    "cross-env": "^10.1.0",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.46.2"
  }
}
